{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "includeFiles": [
        "models/random_forest_pipeline.joblib"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/predict",
      "destination": "/api/predict.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/predict",
      "destination": "/api/predict.py"
    },
    {
      "source": "/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    }
  ]
}
